# Copy to web/.env.local (gitignored) and fill in. Restart `npm run dev` afterwards --
# Vite reads env files at server start, not per request.
#
# There is NO client secret here. Authorization Code + PKCE treats the web app as a public
# client, so the client id is the only value needed and it is not sensitive. Nothing in
# this flow should ever be committed as a secret, because nothing in it is one.

# Spotify dashboard -> your app -> Settings -> Client ID
VITE_SPOTIFY_CLIENT_ID=

# Optional. Defaults to the origin the app is served from, with a trailing slash.
# Set this only for a deployed origin; leave it blank for local development.
#
# IMPORTANT: Spotify does NOT allow `localhost` as a redirect URI. Use the explicit
# loopback literal. Register this exact string in the dashboard under Redirect URIs:
#
#     http://127.0.0.1:5173/
#
# HTTP is permitted for loopback addresses only; every other redirect URI must be HTTPS.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/


# --- one-time dashboard setup ---------------------------------------------------------
#
# 1. https://developer.spotify.com/dashboard -> Create app.
#    Which API/SDK: Web API.
# 2. Redirect URI: http://127.0.0.1:5173/   (not localhost)
# 3. Settings -> User Management -> add yourself by name and Spotify account email.
#    New apps are in development mode: five authorised users, and the app owner needs a
#    Spotify Premium account for the app to function.
# 4. Open the app at http://127.0.0.1:5173 -- `npm run dev` prints that address.
#
# Scopes are requested by the app, not configured here: playlist-modify-private and
# playlist-modify-public, and nothing else. See docs/decisions/0003-spotify-auth.md.
